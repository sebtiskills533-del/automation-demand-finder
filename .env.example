# Copy this file to .env and fill in the values. Never commit .env.

# Your Anthropic API key (console.anthropic.com -> API keys).
ANTHROPIC_API_KEY=

# Dashboard password hash. Do NOT type a password here:
# run `python -m app.set_password` and it fills this in for you.
DASHBOARD_PASSWORD_HASH=

# Cost guards.
MAX_POSTS_PER_RUN=30
MONTHLY_BUDGET_USD=5

# Only used to show approximate rupee amounts in the dashboard.
USD_TO_INR=88

# Optional: your Reddit username, added to the User-Agent as Reddit asks.
REDDIT_USERNAME=

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Optional: collect posts with Muse (muse.ai) through the app's own Chrome.
# See the "Muse" section of README.md before switching this on.
MUSE_ENABLED=false
MUSE_CHAT=AUTOMATION DEMAND FINDER
MUSE_MAX_POSTS=20
MUSE_BROWSER_PORT=9223
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
